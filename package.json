{
  "name": "flowoffice-monorepo",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter belive-fo dev",
    "dev:backend": "cd apps/backend && php artisan serve",
    "dev:queue": "cd apps/backend && php artisan queue:listen --tries=1 --timeout=0",
    "dev:all": "concurrently \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "build": "pnpm --filter belive-fo build",
    "lint": "pnpm --filter belive-fo lint",
    "lint:backend": "cd apps/backend && vendor/bin/pint --dirty",
    "test:backend": "cd apps/backend && composer run test",
    "docker:up": "cd apps/backend && docker compose up -d",
    "docker:down": "cd apps/backend && docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "concurrently": "^8.0.0"
  }
}
