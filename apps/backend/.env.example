# =============================================================================
# FlowOffice — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Run: cp .env.example .env && php artisan key:generate
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=FlowOffice
APP_ENV=local
APP_KEY=                              # Generated by: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur        # PHP timezone for date functions

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1                     # Use "postgres" if running in Docker
DB_PORT=5432
DB_DATABASE=flowoffice
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer                     # Use "require" for Supabase / production

# -----------------------------------------------------------------------------
# Supabase (optional — only needed if using Supabase-hosted Postgres)
# -----------------------------------------------------------------------------
SUPABASE_URL=                         # e.g. https://xxxx.supabase.co
SUPABASE_KEY=                         # anon/public key
SUPABASE_SECRET=                      # service_role key (server-side only)
SUPABASE_JWT_SECRET=                  # JWT secret from Supabase dashboard

# -----------------------------------------------------------------------------
# Cache / Queue / Session
# -----------------------------------------------------------------------------
CACHE_STORE=database                  # Options: database, redis, file
QUEUE_CONNECTION=database             # Options: database, redis, sync
SESSION_DRIVER=database               # Options: database, redis, file

# -----------------------------------------------------------------------------
# Redis (optional — only needed if CACHE_STORE or QUEUE_CONNECTION = redis)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1                  # Use "redis" if running in Docker
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Auth — Sanctum (SPA cookie-based auth)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Lark OAuth (optional — for Lark SSO login)
# -----------------------------------------------------------------------------
LARK_APP_ID=
LARK_APP_SECRET=

# -----------------------------------------------------------------------------
# Google Maps / Places API (optional — for attendance geofencing)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# File Storage — S3 / Supabase Storage (optional — for claim attachments)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=                         # Supabase storage endpoint if applicable
AWS_URL=
ATTACHMENT_BUCKET=Attachment
ATTACHMENT_URL=

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log                       # Use "smtp" for production
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Claims Module
# -----------------------------------------------------------------------------
MILEAGE_RATE_PER_KM=0.70             # Rate per km for mileage claims

# -----------------------------------------------------------------------------
# Organisation Identity (used by OrganizationSettingsSeeder on first migrate --seed)
# -----------------------------------------------------------------------------
ORG_NAME=My Company
# ORG_LOGO_PATH=/images/logos/logo.png
# ORG_SUPPORT_URL=https://support.example.com

# -----------------------------------------------------------------------------
# First-Run Admin Account (created by FirstRunAdminSeeder — change before seeding)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-immediately

# -----------------------------------------------------------------------------
# Demo Mode (set to true for live demo deployments)
# -----------------------------------------------------------------------------
DEMO_MODE=false
SEED_DEMO_DATA=false                  # Set to true to seed demo data on migrate --seed

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
