# ── White-Label / App Identity ─────────────────────────────────────────────────
# Displayed in page title, logo alt text, and welcome messages.
NEXT_PUBLIC_APP_NAME=FlowOffice
NEXT_PUBLIC_APP_DESCRIPTION=FlowOffice - HR Management System
# Path to logo image served from /public (e.g. /images/logos/MyLogo.png)
NEXT_PUBLIC_APP_LOGO_PATH=/images/logos/flowoffice-icon.svg
# Optional support / help URL shown in the app
# NEXT_PUBLIC_SUPPORT_URL=https://support.example.com

# ── Cookie Names ────────────────────────────────────────────────────────────────
# Must match the auth cookie your Laravel backend sets.
# Default: fo_auth_token / fo_staff_auth (change if migrating from an existing deploy)
# AUTH_COOKIE_NAME=fo_auth_token
# AUTH_CACHE_COOKIE_NAME=fo_staff_auth

# ── Location Name Prefix ────────────────────────────────────────────────────────
# Prefix stripped from office/location names in the attendance heatmap.
# Set to your company name prefix (e.g. "Acme ") to clean up chart labels.
# NEXT_PUBLIC_LOCATION_NAME_PREFIX=

# ── Feature Flags ───────────────────────────────────────────────────────────────
# Set to "false" to disable a module entirely (nav hidden + routes blocked).
# All features are ON by default; unset = enabled.
# NEXT_PUBLIC_FEATURE_ATTENDANCE=false
# NEXT_PUBLIC_FEATURE_CLAIMS=false
# NEXT_PUBLIC_FEATURE_LEAVE=false
# NEXT_PUBLIC_FEATURE_ONBOARDING=false
# NEXT_PUBLIC_FEATURE_OVERTIME=false
# NEXT_PUBLIC_FEATURE_REPORTS=false
# NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false
# NEXT_PUBLIC_FEATURE_SHIFT=false

# ── Auth store encryption (min 32 chars). Client-exposed; obfuscates PII in localStorage.
NEXT_PUBLIC_AUTH_STORE_SECRET=

# Supabase Configuration (required for Edge Functions / face verification)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Human API for face recognition (production: https://human-api-blond.vercel.app; local: http://localhost:3001)
# Optional: HUMAN_API_URL (server-only) used by /api/face-verify; falls back to NEXT_PUBLIC_HUMAN_API_URL
NEXT_PUBLIC_HUMAN_API_URL=https://human-api-blond.vercel.app

# Laravel Backend API
NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:8000
# Laravel session cookie name (match backend config/session.php SESSION_COOKIE or APP_NAME)
NEXT_PUBLIC_LARAVEL_SESSION_COOKIE=laravel-session

# Internal BFF Secret
BFF_INTERNAL_SECRET=your_internal_secret

# ── Auth Providers ──────────────────────────────────────────────────────────────
# Comma-separated subset of: email,lark,google,microsoft
# Default: email only. Lark requires a registered Bytedance/Lark application.
# Add providers as needed: email,google or email,lark,google,microsoft
NEXT_PUBLIC_ENABLED_AUTH_PROVIDERS=email

# Lark OAuth Configuration
NEXT_PUBLIC_LARK_APP_ID=your_lark_app_id
NEXT_PUBLIC_LARK_REDIRECT_URI=http://localhost:3000/auth/callback

# Google OAuth (PKCE). NEXT_PUBLIC_GOOGLE_REDIRECT_URI defaults to <origin>/auth/callback.
# OAUTH_GOOGLE_ENABLED gates the Next.js Route Handler -> Laravel exchange. Keep `false`
# until the Laravel /api/auth/google/callback endpoint is implemented.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_GOOGLE_ENABLED=false

# Microsoft Entra ID (Azure AD) OAuth (PKCE).
# TENANT_ID defaults to 'common' (multi-tenant). Use your tenant GUID for single-tenant apps.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_MICROSOFT_ENABLED=false

# Set to "true" only if you ship a first-party service worker (PWA). When unset/false, stale SWs
# from other localhost apps are unregistered on load so Google Maps and other third-party scripts work.
# NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true

# ── Demo Mode ──────────────────────────────────────────────────────────────────
# Set to "true" to show a demo banner and disable mutations in the UI.
# NEXT_PUBLIC_DEMO_MODE=false
# URL shown in the demo banner linking to your purchase page.
# NEXT_PUBLIC_PURCHASE_URL=https://example.com/buy

